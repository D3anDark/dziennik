# Copy to .env and fill in. The app reads plain environment variables and does not load this file itself:
#   set -a; . ./.env; set +a; cargo run --release
# The same file works as a systemd EnvironmentFile=.

# Required (or ALLOWED_EMAILS). Librus account e-mails of the administrators, comma separated.
# They can sign in and manage the access list in the app (Więcej, Dostęp do aplikacji) without a restart.
ADMIN_EMAILS=ty@example.com

# Optional. Extra Librus account e-mails that can always sign in, comma separated. Changing it needs a restart.
ALLOWED_EMAILS=

# Required. 64 hex characters: openssl rand -hex 32
# Keep it constant: changing it invalidates the stored tokens and everyone signs in again.
SECRET_KEY=

# Optional, defaults shown.
DB=dziennik.db
WEB_DIR=web/dist
BIND=127.0.0.1:8080
